{
  "contractVersion": "1.4.0",
  "entries": [
    {
      "id": "primary-column",
      "description": "The main feed column that wraps the timeline.",
      "selectors": ["[data-testid=\"primaryColumn\"]"],
      "required": true
    },
    {
      "id": "timeline-container",
      "description": "The scrollable timeline region whose children are post cells. MutationObserver attaches here.",
      "selectors": [
        "[aria-label=\"Timeline: Your Home Timeline\"]",
        "[data-testid=\"primaryColumn\"] section"
      ],
      "required": true
    },
    {
      "id": "post-article",
      "description": "A single rendered post. One element per post in the timeline.",
      "selectors": ["article[data-testid=\"tweet\"]", "article[role=\"article\"]"],
      "required": true
    },
    {
      "id": "post-text",
      "description": "The visible text content of a post.",
      "selectors": ["[data-testid=\"tweetText\"]"],
      "required": true
    },
    {
      "id": "author-handle",
      "description": "The author's account handle within the post header.",
      "selectors": ["[data-testid=\"User-Name\"] div[dir=\"ltr\"]"],
      "required": true
    },
    {
      "id": "author-display-name",
      "description": "The author's display name within the post header.",
      "selectors": ["[data-testid=\"User-Name\"] div[dir=\"ltr\"]"],
      "required": false
    },
    {
      "id": "ad-label",
      "description": "The visible Ad label shown in a promoted post's header.",
      "selectors": ["div[dir=\"ltr\"] > span"],
      "required": false
    },
    {
      "id": "post-permalink",
      "description": "A link containing the post's status permalink.",
      "selectors": ["a[href*=\"/status/\"]"],
      "required": true
    },
    {
      "id": "post-timestamp",
      "description": "The post timestamp with its machine-readable datetime.",
      "selectors": ["time[datetime]"],
      "required": false
    },
    {
      "id": "post-images",
      "description": "Image media attached to the post.",
      "selectors": ["[data-testid=\"tweetPhoto\"] img"],
      "required": false
    },
    {
      "id": "post-video",
      "description": "Video media attached to the post.",
      "selectors": ["video"],
      "required": false
    },
    {
      "id": "engagement-replies",
      "description": "The reply count control.",
      "selectors": ["[data-testid=\"reply\"]"],
      "required": false
    },
    {
      "id": "engagement-reposts",
      "description": "The repost count control.",
      "selectors": ["[data-testid=\"retweet\"]"],
      "required": false
    },
    {
      "id": "engagement-likes",
      "description": "The like count control.",
      "selectors": ["[data-testid=\"like\"]"],
      "required": false
    },
    {
      "id": "engagement-views",
      "description": "The post analytics control containing the view count.",
      "selectors": ["[aria-label*=\"views. View post analytics\"]"],
      "required": false
    },
    {
      "id": "theme-surface",
      "description": "The page background that carries X's selected theme surface colour.",
      "selectors": ["body"],
      "required": false
    },
    {
      "id": "theme-accent",
      "description": "A compose control whose background is X's user-selected accent colour.",
      "selectors": [
        "[data-testid=\"tweetButtonInline\"]",
        "[data-testid=\"SideNav_NewTweet_Button\"]"
      ],
      "required": false
    },
    {
      "id": "theme-separator",
      "description": "A timeline cell edge whose background approximates X's separator colour.",
      "selectors": ["[data-testid=\"cellInnerDiv\"] > div", "article[data-testid=\"tweet\"]"],
      "required": false
    },
    {
      "id": "profile-join-date",
      "description": "The join date shown on an author profile page. Required false: a profile markup change can never pause timeline filtering.",
      "selectors": ["[data-testid=\"UserProfileHeader_Items\"] time[datetime]"],
      "required": false
    },
    {
      "id": "profile-post-count",
      "description": "The total post count shown on an author profile page. Required false: a profile markup change can never pause timeline filtering.",
      "selectors": [
        "[data-testid=\"UserProfileHeader_Items\"] a[href*=\"/status\"]",
        "[data-testid=\"UserProfileHeader_Items\"] span"
      ],
      "required": false
    }
  ]
}
